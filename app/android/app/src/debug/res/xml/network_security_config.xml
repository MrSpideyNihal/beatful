<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. A development server runs on plain HTTP on the machine's
  LAN address, and Android blocks cleartext by default. Release builds never see
  this file, so a shipped APK still refuses anything but HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
