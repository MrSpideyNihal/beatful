# Copy to .env for local development. .env is gitignored and must stay that way.
# In production these are set in the Render dashboard, never in a committed file.

# Required in production. Least privilege Atlas user, one database.
# MONGO_URI=mongodb+srv://beatful_app:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=beatful

# Required in production. Signs guest tokens. Rotate by generating a new value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# AUTH_SECRET=

PORT=3000
NODE_ENV=development

# silent, error, warn, info or debug. Defaults to debug outside production.
LOG_LEVEL=debug

# Run without any database. Handy offline, and what the API tests use.
USE_MEMORY_DB=true

# Long poll window. Keep below the host proxy limit, which is 30s on Render.
POLL_TIMEOUT_MS=25000

TOKEN_TTL_DAYS=365
ROOM_TTL_HOURS=6
MATCH_TTL_DAYS=60
DISCONNECT_GRACE_MS=60000
LOBBY_IDLE_TIMEOUT_MS=1800000

DEFAULT_TIMER_SECONDS=15
TURN_SWEEP_MS=500

STARTING_COINS=500
MAX_ENTRY_FEE=5000
AD_REWARD_COINS=25
AD_REWARD_DAILY_CAP=5
